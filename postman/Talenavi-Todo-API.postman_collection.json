  "item": [
    {
      "name": "1. Create Todo",
      "description": "POST /api/todos\n\nField: title (wajib), assignee (opsional), due_date (wajib, YYYY-MM-DD, tidak boleh tanggal lampau), time_tracked (angka >= 0, default 0), status (pending | open | in_progress | completed, default pending), priority (wajib: low | medium | high).",
      "item": [
        {
          "name": "Create Todo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Mengembalikan object todo', () => {",
                  "    const todo = pm.response.json().data;",
                  "    pm.expect(todo).to.include.keys('id', 'title', 'assignee', 'due_date', 'time_tracked', 'status', 'priority');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Prepare demo for technical test\",\n    \"assignee\": \"Robert\",\n    \"due_date\": \"2026-12-31\",\n    \"time_tracked\": 1.5,\n    \"status\": \"open\",\n    \"priority\": \"high\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/todos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "todos"
              ]
            },
            "description": "Membuat todo dengan semua field. Response 201 berisi object todo yang baru dibuat.\n\nCatatan: jika tanggal di body sudah lewat, ganti due_date ke hari ini atau tanggal setelahnya."
