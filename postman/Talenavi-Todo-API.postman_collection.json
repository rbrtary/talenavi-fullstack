    {
      "name": "2. Export Todo Report (Excel)",
      "description": "GET /api/todos/export\n\nMenghasilkan file .xlsx dengan kolom: title, assignee, due_date, time_tracked, status, priority, plus baris summary di paling bawah (Total Todos & Total Time Tracked).\n\nKlik panah di samping tombol Send lalu pilih \"Send and Download\" untuk menyimpan file Excel.",
      "item": [
        {
          "name": "Export - semua todo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Response berupa file Excel (.xlsx)', () => {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('spreadsheetml.sheet');",
                  "    pm.expect(pm.response.headers.get('Content-Disposition')).to.include('.xlsx');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/todos/export",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "todos",
